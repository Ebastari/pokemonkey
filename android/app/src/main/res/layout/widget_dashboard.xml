<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: App Name & Subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POKEMONKEY"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Revegetasi &amp; Rehabilitasi PT EBL"
                android:textColor="#A1A1AA"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_widget_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update ..."
            android:textColor="#71717A"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Garis pemisah. Widget hanya boleh memakai tampilan yang didukung RemoteViews
         (FrameLayout, LinearLayout, TextView, ImageView, ...); <View> polos membuat
         layar depan menampilkan "Tidak dapat memuat widget". -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="#20FFFFFF" />

    <!-- Baris 1: Cuaca & Titik Api -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Cuaca -->
        <LinearLayout
            android:id="@+id/btn_widget_cuaca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUACA BMKG"
                android:textColor="#38BDF8"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_cuaca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Memuat cuaca..."
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Titik Api -->
        <LinearLayout
            android:id="@+id/btn_widget_api"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TITIK API NASA"
                android:textColor="#FB923C"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_api"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Aman (0 Titik)"
                android:textColor="#34D399"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Baris 2: Jadwal & Alarm Hari Ini -->
    <LinearLayout
        android:id="@+id/btn_widget_jadwal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_card_bg"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="JADWAL &amp; ALARM HARI INI"
                android:textColor="#FACC15"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_alarm_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_blue"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="Alarm Aktif"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_widget_jadwal_isi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tidak ada agenda rapat hari ini"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Baris 3: PICA -->
    <LinearLayout
        android:id="@+id/btn_widget_pica"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_card_bg"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PICA REVEGETASI"
                android:textColor="#F472B6"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_pica_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_emerald"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="0 Open"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_widget_pica_isi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Semua tugas PICA selesai"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
